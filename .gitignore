# 工作区内部目录（不属于仓库内容）
.tmp/
.workbuddy/
.gocache/
.gopath/

# 构建产物
dist/
**/build/
**/.gradle/
**/.kotlin/
**/local.properties

# Windows 端随包内核（由 scripts/fetch-core.ps1 下载）
RekoboxForWindows/runtime/windows/*.exe
RekoboxForWindows/runtime/windows/*.dll

# 系统文件
.DS_Store
Thumbs.db
*.log

# 本地 Go 依赖（Android libcore 的 go.mod replace 路径）
/libneko/
/sing-box/

# Qt 版 Windows 客户端：三方内核源码与构建产物都不入库
/RekoboxForWindowsQt/_deps/
/RekoboxForWindowsQt/libs/deps/
/RekoboxForWindowsQt/deployment/
/RekoboxForWindowsQt/res/_geodata/
