<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  由 CMakeLists.txt 里的 configure_file(... @ONLY) 在 configure 阶段填好，
  再把结果路径交给 MACOSX_BUNDLE_INFO_PLIST。

  这里刻意不用 CMake 内置的 @MACOSX_BUNDLE_xxx@ 隐式变量：在
  qt_add_executable(MANUAL_FINALIZATION) 这条路径上它们没有被定义，
  生成出来的 plist 里 Executable / Identifier 全是空串（签名会退化成自动 ID）。
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleExecutable</key>
    <string>@NKR_BUNDLE_EXECUTABLE@</string>
    <key>CFBundleIdentifier</key>
    <string>@NKR_BUNDLE_IDENTIFIER@</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>@NKR_BUNDLE_NAME@</string>
    <key>CFBundleDisplayName</key>
    <string>@NKR_BUNDLE_NAME@</string>
    <key>CFBundleIconFile</key>
    <string>@NKR_BUNDLE_ICON@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@NKR_BUNDLE_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@NKR_BUNDLE_VERSION@</string>
    <key>LSMinimumSystemVersion</key>
    <string>@NKR_MIN_MACOS@</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <!-- 有 Dock 图标；"仅菜单栏"用运行时 setActivationPolicy 实现，不改 plist -->
    <key>LSUIElement</key>
    <false/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>GPL-3.0 · RekoBox</string>
</dict>
</plist>
